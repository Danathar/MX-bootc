{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
  ],

  "rebaseWhen": "never",

  "packageRules": [
    {
      "automerge": true,
      "matchUpdateTypes": ["pin", "pinDigest"]
    },
    {
      "description": "Keep image and build-tool inputs current",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "docker.io/library/debian",
        "quay.io/centos-bootc/bootc-image-builder"
      ],
      "enabled": true
    },
    {
      "description": "Keep pinned source revisions current",
      "matchFileNames": ["build_files/install-bootc"],
      "enabled": true
    }
  ]
}
