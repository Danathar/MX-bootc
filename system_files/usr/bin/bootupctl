#!/bin/sh
set -eu

case "${1:-}" in
  backend)
    if [ "${2:-}" = "install" ]; then
      # systemd-boot is installed and populated by the bootc image builder.
      # There is intentionally no GRUB fallback: this image removes signed GRUB.
      echo "bootupctl: systemd-boot is managed by bootc-image-builder" >&2
      exit 0
    fi
    ;;
esac

echo "bootupctl: unsupported operation for this systemd-boot image: $*" >&2
exit 2
