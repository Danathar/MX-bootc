# Test-only derivative used by .github/workflows/test.yml.
# Keep the autologin configuration out of the distributed image.
FROM localhost/mx-bootc:ci

RUN mkdir -p /usr/etc/sddm.conf.d && \
    printf '%s\n' \
      '[Autologin]' \
      'User=mx' \
      'Session=plasma.desktop' \
      'Relogin=true' \
      > /usr/etc/sddm.conf.d/99-bootc-smoke.conf

# The distributed image intentionally expires the installer-created password;
# the smoke image uses an injected SSH key and must be able to autologin.
RUN mkdir -p /usr/etc/systemd/system && \
    ln -sf /dev/null /usr/etc/systemd/system/mx-bootc-first-boot.service
