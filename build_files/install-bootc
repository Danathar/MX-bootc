#!/bin/bash

set -ouex pipefail

# FIXME: Replace this bootstrap with Debian packages when a Debian-compatible
# upstream bootc release passes this repository's container lint and boot test.
# bootc is pinned to the frostyard fork because this project currently relies on
# its Debian compatibility work; the fork is not a long-term support promise.

# renovate: datasource=git-refs depName=github.com/ostreedev/ostree
OSTREE_REF="4672e91445451660eaa4405630692ade1b48c914" # v2026.2
# renovate: datasource=git-refs depName=github.com/frostyard/bootc
BOOTC_REF="cd2594a759f3efe5328c6235847b18fd75e561f5" # main

TMPROOT=/var/tmp/mx-bootc-build

cleanup() {
  rm -rf -- "${TMPROOT}"
  echo "::endgroup::"
}

echo "::group::Executing install-bootc"
trap cleanup EXIT

DEV_DEPS=(
  libcurl4-openssl-dev libzstd-dev libssl-dev pkg-config curl git build-essential meson
  libfuse3-dev liblzma-dev libarchive-dev libsoup2.4-dev e2fslibs-dev libext2fs-dev libgpgme-dev go-md2man
  autoconf automake libtool libseccomp-dev libcap-dev libglib2.0-dev bison flex equivs gobject-introspection
)

mkdir -p "${TMPROOT}"
export CARGO_HOME="${TMPROOT}/rust"
export RUSTUP_HOME="${TMPROOT}/rust"
export DRACUT_NO_XATTR=1

# Remove unneeded repositories and update
rm -f /etc/apt/apt.conf.d/docker-gzip-indexes /etc/apt/apt.conf.d/docker-no-languages
apt update -y

# Install needed dependencies for building bootc/ostree
apt install -y "${DEV_DEPS[@]}" ca-certificates libarchive13 --no-install-recommends

# Set up rust build environment
curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- --profile minimal --no-modify-path -y
# shellcheck source=/dev/null
. "${RUSTUP_HOME}/env"

# Fetch one immutable source revision without relying on a moving branch.
fetch_source() {
  local repo="$1"
  local ref="$2"
  local destination="$3"
  git init --quiet "${destination}"
  git -C "${destination}" remote add origin "${repo}"
  git -C "${destination}" fetch --quiet --depth 1 origin "${ref}"
  git -C "${destination}" checkout --quiet --detach FETCH_HEAD
}

# Build and install OSTree.
fetch_source https://github.com/ostreedev/ostree.git "${OSTREE_REF}" "${TMPROOT}/ostree"
pushd "${TMPROOT}/ostree"
git submodule update --init
env NOCONFIGURE=1 ./autogen.sh
./configure --prefix=/usr --libdir=/usr/lib --sysconfdir=/etc --with-curl --with-dracut
make -j"$(nproc)"
make install
popd
ln -svf /usr/lib/libostree* "/lib/$(arch)-linux-gnu/" || true
ldconfig

# Build and install Bootc.
fetch_source https://github.com/frostyard/bootc.git "${BOOTC_REF}" "${TMPROOT}/bootc"
pushd "${TMPROOT}/bootc"
export PKG_CONFIG_PATH=/usr/lib/pkgconfig:/usr/share/pkgconfig
make bin install-all
popd

# Build and install a dummy libostree-1-1 package for dependant packages
mkdir -p "${TMPROOT}/equivs"
cat > "${TMPROOT}/equivs/libostree-fix" <<EOF
Section: misc
Priority: optional
Standards-Version: 3.9.2

Package: libostree-1-1
Version: 2025.6
Maintainer: Snow Linux <snow@snowlinux.org>
Architecture: $(dpkg --print-architecture)
Description: Dummy package to provide libostree-1-1
EOF

pushd "${TMPROOT}/equivs"
equivs-build libostree-fix
dpkg -i ./*.deb
popd

apt-mark hold libostree-1-1

# Remove no longer needed packages
apt purge -y "${DEV_DEPS[@]}"
apt autoremove -y --purge
